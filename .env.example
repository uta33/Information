# ─── Database ───────────────────────────────────────────
# Local: sqlite+aiosqlite:///./infowatch.db
# Cloud: postgresql://user:pass@host:5432/infowatch
DATABASE_URL=sqlite+aiosqlite:///./infowatch.db

# ─── App ────────────────────────────────────────────────
SECRET_KEY=change-me-use-long-random-string-here

# ─── VAPID (Web Push) ────────────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print('PRIVATE:', v.private_key); print('PUBLIC:', v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBSCRIBER_EMAIL=admin@example.com

# ─── NVD API (optional) ─────────────────────────────────
# Register at https://nvd.nist.gov/developers/request-an-api-key
# Raises rate limit from 5 req/30s → 50 req/30s
NVD_API_KEY=

# ─── CORS ───────────────────────────────────────────────
# CORS_ORIGINS=["https://your-frontend.railway.app"]
